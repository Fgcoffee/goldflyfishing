__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/dist/
# PyInstaller's working directory (BUILD.md passes --workpath build/work).
build/work/
dist/
# Agent worktrees: copies of this repository.
.claude/

# The card pool. The Scryfall dumps below are kept - they are the input, they
# change only when Scryfall republishes, and a clone with no network can build
# the database from them (fetch_scryfall --offline). The database itself is
# derived, 95 MB, and rebuilt whole every time, so it stays out.
cache/*
!cache/scryfall/
!cache/comprehensive_rules.txt
!cache/pool.json
*.sqlite
*.sqlite-journal
*.jsonl
*.jsonl.gz
!cache/scryfall/*.jsonl.gz

# Simulation output
runs/
*.parquet

# Benchmark results are kept, so a change can be compared against the numbers
# it is meant to improve (bench/run_cost_bench.sh regenerates them).
!bench/results/*.jsonl
